# =============================================
# 공통 환경 변수 예시 파일
# 실제 사용 시 .env 파일로 복사 후 값 수정
# =============================================

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cowork_db
POSTGRES_USER=cowork_user
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql+psycopg2://cowork_user:your_password_here@db:5432/cowork_db

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Realtime Server ---
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8001
REDIS_URL=redis://redis:6379/0

# --- AI Chatbot ---
AI_CHATBOT_HOST=0.0.0.0
AI_CHATBOT_PORT=8002
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# or
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Frontend ---
# Leave blank to use the built-in Next.js proxy routes:
#   browser -> http://SERVER_IP:3000/backend/* -> backend:8000
#   browser -> http://SERVER_IP:3000/ai/*      -> ai-chatbot:8002/api/*
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_AI_CHATBOT_URL=/ai

# --- Hostname / Reverse Proxy ---
# Example Windows computer name: cowork-server
APP_HOSTNAME=cowork-server

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
