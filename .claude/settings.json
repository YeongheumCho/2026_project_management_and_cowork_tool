{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff -- *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(pytest)",
      "Bash(docker compose ps)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Read(./realtime/.env)",
      "Read(./realtime/.env.*)",
      "Read(./ai-chatbot/.env)",
      "Read(./ai-chatbot/.env.*)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.*)",
      "Read(./**/secrets/**)"
    ]
  }
}
